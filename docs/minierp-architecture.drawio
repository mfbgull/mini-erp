        <mxCell id="43" parent="40" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=6;" value="&lt;b&gt;Views &amp;amp; Migrations&lt;/b&gt;&#xa;&#xa;Views: vw_customers_with_balance,&#xa;       vw_items_with_stock&#xa;&#xa;36 migration files (idempotent, rerunnable)&#xa;Rollback support per migration&#xa;Auto-apply on server start" vertex="1">
