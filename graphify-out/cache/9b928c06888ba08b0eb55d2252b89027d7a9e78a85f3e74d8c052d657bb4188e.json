dress,\n            customer_phone: invoice.customer_phone,\n            customer_email: invoice.customer_email,\n            items: invoice.items as Array<{ quantity?: number; unit_price?: number; rate?: number; item_name?: string; description?: string; item_code?: string }>,\n            total_amount: invoice.total_amount,\n            paid_amount: invoice.paid_amount,\n            balance_amount: invoice.balance_amount,\n            returned_amount: invoice.returned_amount,\n            payment_terms_days: invoice.payment_terms_days,\n          }}\n          company={company}\n        />\n      );\n\n      requestAnimationFrame(() => {\n        requestAnimationFrame(() => {\n          printWindow.print();\n          printWindow.close();\n        });\n      });\n    }\n\n    toast.success(t('common.receiptPrinting'));\n  };\n\n  const handleDownloadPDF = async () => {\n    if (!invoiceRef.current) return;\n\n    setIsExporting(true);\n    try {\n      const canvas = await html2canvas(invoiceRef.current, {\n        scale: 2,\n        useCORS: true,\n        logging: false,\n        backgroundColor: '#ffffff'\n      });\n\n      const imgData = canvas.toDataURL('image/png');\n      const pdf = new jsPDF({\n        orientation: 'portrait',\n        unit: 'mm',\n        format: 'a4'\n      });\n\n      const pdfWidth = pdf.internal.pageSize.getWidth();\n      const pdfHeight = pdf.internal.pageSize.getHeight();\n      const imgWidth = canvas.width;\n      const imgHeight = canvas.height;\n      const ratio = Math.min(pdfWidth / imgWidth, pdfHeight / imgHeight);\n      const imgX = (pdfWidth - imgWidth * ratio) / 2;\n      const imgY = 10;\n\n      pdf.addImage(imgData, 'PNG', imgX, imgY, imgWidth * ratio, imgHeight * ratio);\n      pdf.save(`${invoice?.invoice_no ?? 'invoice'}.pdf`);\n\n      toast.success('PDF downloaded successfully');\n    } catch (err) {\n      console.error('PDF export error:', err);\n      toast.error('Failed to generate PDF');\n    } finally {\n      setIsExporting(false);\n    }\n  }", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L153"}, {"caller_nid": "invoiceviewpage_handleprintreceipt", "callee": "requestAnimationFrame", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L171"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "error", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L240"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "confirm", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L243"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "setIsCancelling", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L246"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "put", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L248"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "success", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L249"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "invalidateQueries", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L250"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "invalidateQueries", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L251"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "error", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L254"}, {"caller_nid": "invoiceviewpage_handlecancel", "callee": "setIsCancelling", "source_file": "/home/fawad/ai/minierp/client/src/pages/sales/InvoiceViewPage.tsx", "source_location": "L256