allocations.map((alloc) => {\n        const invoiceId = parseInt(alloc.invoice_id, 10);\n        const inv = db.prepare('SELECT invoice_no FROM invoices WHERE id = ?').get(invoiceId) as { invoice_no: string } | undefined;\n        return inv?.invoice_no || `Invoice #${invoiceId}`;\n      });\n\n      db.prepare(`\n        INSERT INTO customer_ledger (customer_id, transaction_date, transaction_type, reference_no, debit, credit, balance, description)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n      `).run(data.customer_id, data.payment_date, 'PAYMENT', paymentNo, 0, data.amount, newBalance, `Payment against ${invoiceNumbers.join(', ')}`);\n\n      ledgerUtils.updateCustomerBalance(data.customer_id);\n\n      return paymentId;\n    })", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L156"}, {"caller_nid": "payment_paymentmodel_create", "callee": "transaction", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L156"}, {"caller_nid": "payment_paymentmodel_update", "callee": "run", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L200"}, {"caller_nid": "payment_paymentmodel_update", "callee": "prepare", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L200"}, {"caller_nid": "payment_paymentmodel_update", "callee": "updateCustomerBalance", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L207"}, {"caller_nid": "payment_paymentmodel_update", "callee": "all", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L209"}, {"caller_nid": "payment_paymentmodel_update", "callee": "prepare", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L209"}, {"caller_nid": "payment_paymentmodel_update", "callee": "calculateInvoiceBalance", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "sourc