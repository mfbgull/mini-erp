odels/Payment.ts", "source_location": "L133"}, {"caller_nid": "payment_paymentmodel_getall", "callee": "prepare", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L133"}, {"caller_nid": "payment_paymentmodel_getall", "callee": "push", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L143"}, {"caller_nid": "payment_paymentmodel_getall", "callee": "push", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L145"}, {"caller_nid": "payment_paymentmodel_getall", "callee": "parseInt", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L145"}, {"caller_nid": "payment_paymentmodel_getall", "callee": "push", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L146"}, {"caller_nid": "payment_paymentmodel_getall", "callee": "push", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L147"}, {"caller_nid": "payment_paymentmodel_getall", "callee": "get", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L149"}, {"caller_nid": "payment_paymentmodel_getall", "callee": "prepare", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L149"}, {"caller_nid": "payment_paymentmodel_create", "callee": "db.transaction(() => {\n      const paymentNo = this.generatePaymentNo(db);\n\n      const paymentResult = db.prepare(`\n        INSERT INTO payments (payment_no, customer_id, payment_date, amount, payment_method, reference_no, notes)\n        VALUES (?, ?, ?, ?, ?, ?, ?)\n      `).run(paymentNo, data.customer_id, data.payment_date, data.amount, data.payment_method || 'Cash', data.reference_no || '', data.notes || '');\n\n      const paymentId = paymentResult.lastInsertRowid as number;\n\n      for (const alloc of data.invoice_allocations) {\n        const invoiceId = parseInt(alloc.invoice_id, 10);\n        db.prepare('INSERT INTO payment_allocations (payment_id, invoice_id, amount) VALUES (?, ?, ?)').run(paymentId, invoiceId, alloc.amount);\n        ledgerUtils.calculateInvoiceBalance(invoiceId);\n        ledgerUtils.updateInvoiceStatus(invoiceId);\n      }\n\n      const currentBalance = db.prepare('SELECT current_balance FROM customers WHERE id = ?').get(data.customer_id) as { current_balance: number };\n      const newBalance = subtractCurrency(parseCurrency(currentBalance.current_balance), parseCurrency(data.amount));\n\n      const invoiceNumbers = data.invoice_allocations.map((alloc) => {\n        const invoiceId = parseInt(alloc.invoice_id, 10);\n        const inv = db.prepare('SELECT invoice_no FROM invoices WHERE id = ?').get(invoiceId) as { invoice_no: string } | undefined;\n        return inv?.invoice_no || `Invoice #${invoiceId}`;\n      });\n\n      db.prepare(`\n        INSERT INTO customer_ledger (customer_id, transaction_date, transaction_type, reference_no, debit, credit, balance, description)\n        VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n      `).run(data.customer_id, data.payment_date, 'PAYMENT', paymentNo, 0, data.amount, newBalance, `Payment against ${invoiceNumbers.join(', ')}`);\n\n      // GL Phase-2 wiring: post the payment to the journal so the\n      // new TB and BS pick it up. The customer_ledger above is the\n      // sub-ledger; this is the GL posting. Both must happen in the\n      // same transaction for atomicity.\n      AccountingService.postPaymentEntry(db, {\n        paymentId,\n        paymentNo,\n        amount: parseCurrency(data.amount),\n        paymentDate: data.payment_date,\n        paymentMethod: data.payment_method,\n        customerId: data.customer_id,\n        userId: data.userId,\n      });\n\n      ledgerUtils.updateCustomerBalance(data.customer_id);\n\n      return paymentId;\n    })", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L158"}, {"caller_nid": "payment_paymentmodel_create", "callee": "transaction", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L158"}, {"caller_nid": "payment_paymentmodel_update", "callee": "run", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L216"}, {"caller_nid": "payment_paymentmodel_update", "callee": "prepare", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L216"}, {"caller_nid": "payment_paymentmodel_update", "callee": "updateCustomerBalance", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L223"}, {"caller_nid": "payment_paymentmodel_update", "callee": "all", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L225"}, {"caller_nid": "payment_paymentmodel_update", "callee": "prepare", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L225"}, {"caller_nid": "payment_paymentmodel_update", "callee": "calculateInvoiceBalance", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L227"}, {"caller_nid": "payment_paymentmodel_update", "callee": "updateInvoiceStatus", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L228"}, {"caller_nid": "payment_paymentmodel_delete", "callee": "db.transaction(() => {\n      const allocations = db.prepare('SELECT * FROM payment_allocations WHERE payment_id = ?').all(id) as Array<{ invoice_id: number }>;\n      db.prepare('DELETE FROM payment_allocations WHERE payment_id = ?').run(id);\n      db.prepare('DELETE FROM payments WHERE id = ?').run(id);\n      db.prepare('DELETE FROM customer_ledger WHERE reference_no = ?').run(existing.payment_no);\n\n      for (const alloc of allocations) {\n        try {\n          ledgerUtils.calculateInvoiceBalance(alloc.invoice_id);\n          ledgerUtils.updateInvoiceStatus(alloc.invoice_id);\n        } catch (err) {\n          logger.warn('Payment.delete: failed to update invoice balance', { invoice_id: alloc.invoice_id, error: err instanceof Error ? err.message : err });\n        }\n      }\n\n      try { ledgerUtils.updateCustomerBalance(existing.customer_id); } catch (err) {\n        logger.warn('Payment.delete: failed to update customer balance', { customer_id: existing.customer_id, error: err instanceof Error ? err.message : err });\n      }\n\n      try { ledgerUtils.rebuildLedgerBalances(existing.customer_id); } catch (err) {\n        logger.warn('Payment.delete: failed to rebuild ledger balances', { customer_id: existing.customer_id, error: err instanceof Error ? err.message : err });\n      }\n    })", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L239"}, {"caller_nid": "payment_paymentmodel_delete", "callee": "transaction", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L239"}, {"caller_nid": "payment_paymentmodel_getallocationsbypaymentid", "callee": "all", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L268"}, {"caller_nid": "payment_paymentmodel_getallocationsbypaymentid", "callee": "prepare", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L268"}, {"caller_nid": "payment_paymentmodel_getallocationsbyinvoiceid", "callee": "all", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L275"}, {"caller_nid": "payment_paymentmodel_getallocationsbyinvoiceid", "callee": "prepare", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L275"}, {"caller_nid": "payment_paymentmodel_deleteallocationsbypaymentid", "callee": "run", "source_file": "/home/fawad/ai/minierp/server/src/models/Payment.ts", "source_location": "L284"}, {"caller_nid": "payment_paymentmodel_deleteallocationsbypaymentid", "callee": "prepare", "sou