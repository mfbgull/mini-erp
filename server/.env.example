# =============================================================================
# Mini ERP - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# Server Configuration
PORT=3011
HOST=0.0.0.0
NODE_ENV=development

# =============================================================================
# SECURITY - CRITICAL
# =============================================================================

# JWT Secret - MUST be changed in production!
# Use: openssl rand -base64 64
# Minimum 32 characters, cryptographically random
JWT_SECRET=mini-erp-secret-key-change-in-production

# Allowed CORS Origins (comma-separated, no spaces)
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
# In production, NEVER use wildcard or localhost
ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3011,http://127.0.0.1:3010,http://127.0.0.1:3011

# =============================================================================
# DATABASE
# =============================================================================

DATABASE_PATH=./database/erp.db

# =============================================================================
# OPTIONAL: External Services
# =============================================================================

# SendGrid Email
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Exchange Rates API
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Weather API (optional)
WEATHER_API_KEY=your_weather_api_key
